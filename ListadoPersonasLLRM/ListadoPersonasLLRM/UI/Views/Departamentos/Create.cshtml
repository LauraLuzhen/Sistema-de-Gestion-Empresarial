@using Domain.Entities
@model clsDepartamento

@{
    ViewData["Title"] = "Añadir Nuevo Departamento";
}

<h1>Añadir Departamento</h1>
<h4>Datos del Nuevo Departamento</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger" role="alert">
                    <strong>Error:</strong> @TempData["ErrorMessage"]
                </div>
            }

            <div class="form-group">
                <label asp-for="Nombre" class="control-label"></label>

                <input asp-for="Nombre" class="form-control" />
            </div>

            <br />
            <div class="form-group">
                <input type="submit" value="Crear Departamento" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<br />
<div>
    <a asp-action="Index" class="btn btn-primary">Volver al Listado</a>
</div>