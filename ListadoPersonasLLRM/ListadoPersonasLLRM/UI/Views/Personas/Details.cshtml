@using Domain.Entities
@model clsPersona

@{
    ViewData["Title"] = "Detalles de Persona";
}

<h1>Detalles de Persona</h1>

<div>
    <hr />
    <div class="row">
        <div class="col-md-4 text-center">
            <img src="@Model.FotoURL" alt="Foto de @Model.Nombre" class="img-thumbnail" style="width: 200px; height: 200px; object-fit: cover; border-radius: 50%;" />
            <h4 class="mt-2">@Model.Nombre @Model.Apellidos</h4>
        </div>

        <div class="col-md-8">
            <dl class="row">
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.ID)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.ID)
                </dd>

                <dt class="col-sm-3">
                    Nombre Completo
                </dt>
                <dd class="col-sm-9">
                    @Model.Nombre @Model.Apellidos
                </dd>

                <dt class="col-sm-3">
                    Departamento
                </dt>
                <dd class="col-sm-9">
                    <strong>@Model.NombreDepartamento</strong>
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.FechaNacimiento)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.FechaNacimiento)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Telefono)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Telefono)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Direccion)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Direccion)
                </dd>
            </dl>
        </div>
    </div>
</div>

<br />
<div>
    <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-warning">Editar</a> |
</div>
<br />
<div>
    <a asp-action="Index" class="btn btn-primary">Volver al Listado</a>
</div>