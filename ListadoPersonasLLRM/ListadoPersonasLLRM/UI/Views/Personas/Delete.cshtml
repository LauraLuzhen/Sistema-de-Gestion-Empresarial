@using Domain.Entities
@model clsPersona

@{
    ViewData["Title"] = "Eliminar Persona";
}

<h1>Eliminar Persona</h1>

<h4 class="text-danger">¿Estás seguro de que quieres eliminar a esta persona?</h4>
<hr />

<div>
    <h4>@Model.Nombre @Model.Apellidos</h4>
    <hr />

    <dl class="row">

        <dt class="col-sm-2">
            Foto
        </dt>
        <dd class="col-sm-10">
            <img src="@Model.FotoURL" alt="Foto de @Model.Nombre" class="img-thumbnail" style="width: 100px; height: 100px; object-fit: cover; border-radius: 50%;" />
        </dd>

        <dt class="col-sm-2">
            Nombre Completo
        </dt>
        <dd class="col-sm-10">
            @Model.Nombre @Model.Apellidos
        </dd>

        <dt class="col-sm-2">
            Departamento
        </dt>
        <dd class="col-sm-10">
            <strong>@Model.NombreDepartamento</strong>
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.FechaNacimiento)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FechaNacimiento)
        </dd>

    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="ID" />

        <input type="submit" value="Eliminar Permanentemente" class="btn btn-danger" /> |
    </form>
</div>
<br />
<div>
    <a asp-action="Index" class="btn btn-primary">Cancelar y Volver al Listado</a>
</div>